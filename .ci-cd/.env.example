# Telegram token received from @BotFather
BOT_TOKEN=YOUR_TELEGRAM_TOKEN

# PostgreSQL database settings
POSTGRES_USER=botuser
POSTGRES_PASSWORD=botpassword
POSTGRES_DB=pingbot

# SQLAlchemy connection URL (must match the data above)
DATABASE_URL=postgresql+asyncpg://botuser:botpassword@db/pingbot

# Часовий пояс для відображення статистики
TZ=Europe/Kyiv

# Кількість послідовних пінгів для підтвердження зміни статусу (1 пінг = 1 хвилина)
STATUS_CHANGE_THRESHOLD=5

# pgAdmin settings for database management interface
PGADMIN_DEFAULT_EMAIL=admin@svitlo.bot
PGADMIN_DEFAULT_PASSWORD=adminpassword
